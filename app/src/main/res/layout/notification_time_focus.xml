<?xml version="1.0" encoding="utf-8"?>
<!--
  Time Focus notification, expanded: a block in the theme's colour with
  the slot name and time, the icons of the apps it limits, and the last opened app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="140dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/notification_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/time_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/notification_text_muted"
            android:textSize="12sp" />

        <!-- Up to 5 app icons; the ones not needed are hidden. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/app_icon_0"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/app_icon_1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/app_icon_2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/app_icon_3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/app_icon_4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/more_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/notification_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/last_opened"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"
            android:textColor="@color/notification_text"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
