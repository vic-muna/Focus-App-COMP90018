<?xml version="1.0" encoding="utf-8"?>
<!-- Time Focus notification, collapsed: a block in the theme's colour with the slot name and the last opened app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="64dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/notification_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/last_opened"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/notification_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
