                android:endY="86"
                android:startX="40"
                android:startY="24"
                android:type="linear">
                <item android:color="#EDE9DE" android:offset="0.0" />
                <item android:color="#EDE9DE" android:offset="0.35" />
                <item android:color="#FEB15F" android:offset="1.0" />
            </gradient>
