<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        NOTE (Permissions - intentionally left commented out):
        The mechanisms described in the project plan (location zones, shake/
        face-down gestures, ambient volume detection, cloud sync) will each
        need a runtime permission below. They are commented out for now
        because this skeleton does not access any of them yet - uncomment
        the ones you need as you implement each feature, and remember
        Android also requires you to *request* dangerous permissions at
        runtime, not just declare them here.

        <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
        <uses-permission android:name="android.permission.RECORD_AUDIO" />
        <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
        <uses-permission android:name="android.permission.INTERNET" />
        <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    -->

    <!-- Needed by the Location Zone edit page's "Use current location" button. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Required since Android 11 (API 30): apps can no longer see every
        other installed package by default ("package visibility"
        restrictions). This <queries> block tells the OS "let me see any
        app that has a launcher icon" - exactly what the app-picker dialog
        needs (PackageManager.queryIntentActivities with this same intent
        filter), without requiring the much more sensitive
        QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        [David Shiau, 2026-09-20] Needed for UsageStatsManager (Settings'
        "Check App Usage Duration" button). This is a "special" permission -
        declaring it here does NOT grant it; the user must still flip it on
        manually via Settings.ACTION_USAGE_ACCESS_SETTINGS (see
        data/usagestats/UsageStatsProvider.kt), the same two-step pattern as
        BIND_ACCESSIBILITY_SERVICE. tools:ignore="ProtectedPermissions"
        silences Lint's warning that this permission is normally
        system-only - it isn't, for this specific one.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        [Claude, 2026-09-21] Needed for FocusTimerService, the persistent
        "focus session active" notification-shade entry. FOREGROUND_SERVICE
        is required on all API levels to run any foreground service;
        FOREGROUND_SERVICE_SPECIAL_USE is additionally required on API 34+
        since this service doesn't fit any of the OS's predefined
        foreground-service types (mediaPlayback, location, etc). SPECIAL_USE
        is itself a "special" permission like PACKAGE_USAGE_STATS above -
        it doesn't need user grant, but Play Store review does require the
        matching <property> tag on the <service> below explaining why.
        POST_NOTIFICATIONS is the separate, API 33+ *runtime* permission
        needed to actually display any notification at all (requested in
        MainActivity.onCreate).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        android:supportsRtl="true">

        <!--
            Single-Activity app: every screen is a Composable, navigated
            between with Jetpack Navigation Compose (see
            ui/navigation/NavGraph.kt). No other Activities are needed.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FocusAccessibilityService - prototype for detecting/restricting
            other apps. A few things here are NOT optional boilerplate:

            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
                Required by the OS on every AccessibilityService, so that
                only the system itself is allowed to bind to (i.e. start
                talking to) it - prevents other apps from impersonating
                the accessibility framework to control your service.

            The <intent-filter> action is how Android's Settings app finds
            this class and lists it as an available accessibility service
            in the first place.

            The <meta-data> points at res/xml/accessibility_service_config.xml,
            which is where we declare WHICH events we want to be told about.
        -->
        <!--
            [David Shiau, 2026-09-20] BlockedActivity - the "this app is
            blocked" screen FocusAccessibilityService launches over whatever
            restricted app just came to the foreground. launchMode="singleTask"
            + taskAffinity="" put it in its own isolated task, separate from
            the blocked app's task, so dismissing it (or the system Back
            gesture) can go straight Home without revealing the blocked app
            underneath - see BlockedActivity.kt's doc comment.
        -->
        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <service
            android:name=".data.accessibility.FocusAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".data.sensor.GeofenceBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!--
            [Claude, 2026-09-21] FocusTimerService - shows a persistent,
            non-dismissable notification-shade entry with a live timer for
            as long as a focus session is active (see NavGraph.kt's
            startFocusSession/onEndSessionClick). Entirely separate from
            FocusAccessibilityService above: this only owns the
            notification, it does not do any app-blocking itself.
        -->
        <service
            android:name=".data.notification.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a persistent timer notification while a focus session is blocking distracting apps" />
        </service>

    </application>

</manifest>
