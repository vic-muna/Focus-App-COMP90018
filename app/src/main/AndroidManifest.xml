<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        NOTE (Permissions - intentionally left commented out):
        The mechanisms described in the project plan (shake/face-down
        gestures, ambient volume detection, screen-usage-time detection)
        will each need a runtime permission below. They stay commented out
        because this branch's UI doesn't implement any of them yet -
        uncomment the ones you need as you implement each feature, and
        remember Android also requires you to *request* dangerous
        permissions at runtime, not just declare them here.

        <uses-permission android:name="android.permission.RECORD_AUDIO" />
        <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
        <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    -->

    <!--
        Required since Android 11 (API 30): apps can no longer see every
        other installed package by default ("package visibility"
        restrictions). This <queries> block tells the OS "let me see any
        app that has a launcher icon" - exactly what InstalledAppsProvider's
        getLaunchableApps() (used by the Apps screens) needs
        (PackageManager.queryIntentActivities with this same intent
        filter), without requiring the much more sensitive
        QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Needed by the Location Zone edit page's "Use current location"
         button, the Map tab's GPS-tracking test UI, and Focus Zone
         geofencing (see data/sensor/GeofenceDataSource.kt). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- The Room + Firebase data layer in this branch (FirebaseRemoteDataSource,
         session cloud-sync, Study Party) is actually implemented and needs
         these to reach Firebase at runtime. Normal permissions, no runtime
         request needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.FocusApp"
        android:supportsRtl="true">

        <!--
            Single-Activity app: every screen is a Composable, navigated
            between with Jetpack Navigation Compose (see
            ui/navigation/NavGraph.kt). No other Activities are needed.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FocusAccessibilityService - prototype for detecting/restricting
            other apps. A few things here are NOT optional boilerplate:

            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
                Required by the OS on every AccessibilityService, so that
                only the system itself is allowed to bind to (i.e. start
                talking to) it - prevents other apps from impersonating
                the accessibility framework to control your service.

            The <intent-filter> action is how Android's Settings app finds
            this class and lists it as an available accessibility service
            in the first place.

            The <meta-data> points at res/xml/accessibility_service_config.xml,
            which is where we declare WHICH events we want to be told about.
        -->
        <service
            android:name=".data.accessibility.FocusAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            GeofenceBroadcastReceiver - wakes up when the OS detects the
            device entering/exiting a registered Focus Zone geofence (see
            data/sensor/GeofenceDataSource.kt), even if the app isn't
            running in the foreground.
        -->
        <receiver
            android:name=".data.sensor.GeofenceBroadcastReceiver"
            android:exported="true">
        </receiver>

    </application>

</manifest>
